#!/bin/sh
# 提交信息格式校验：<type>(<scope>): <描述>
# 安装：cp docs/hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# 跳过校验：git commit --no-verify

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# 合并提交与回滚提交放行
case "$first_line" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|hotfix|perf|refactor|style|docs|test|build|ci|chore|revert)(\([a-z0-9-]+\))?: .{1,}'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo ""
  echo "✖ 提交信息不符合规范：$first_line"
  echo ""
  echo "  正确格式：<type>(<scope>): <简述>"
  echo "  示例    ：feat(cafeteria): 新增食堂窗口实时排队人数"
  echo "  type    ：feat fix hotfix perf refactor style docs test build ci chore revert"
  echo "  规范详见：docs/GIT-WORKFLOW.md 第 3 节"
  echo ""
  exit 1
fi

if [ "$(printf '%s' "$first_line" | wc -m)" -gt 72 ]; then
  echo "✖ 首行过长（> 72 字符），请精简后重试"
  exit 1
fi

exit 0
